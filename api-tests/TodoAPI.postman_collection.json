{
  "info": {
    "name": "Todo REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET all todos - empty list",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/todos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));",
              "pm.test('Response time under 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create todo - happy path",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/todos",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Buy groceries\", \"description\": \"Milk, eggs, bread\", \"completed\": false}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Location header exists', () => pm.expect(pm.response.headers.get('Location')).to.exist);",
              "const json = pm.response.json();",
              "pm.test('Response has id', () => pm.expect(json).to.have.property('id'));",
              "pm.test('Title matches', () => pm.expect(json.title).to.eql('Buy groceries'));",
              "pm.test('Completed is false by default', () => pm.expect(json.completed).to.be.false);",
              "pm.test('createdAt exists', () => pm.expect(json).to.have.property('createdAt'));",
              "pm.test('Response time under 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
              "pm.environment.set('todoId', String(json.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create todo - blank title (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/todos",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"\", \"description\": \"Test\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "const json = pm.response.json();",
              "pm.test('Error response has status field', () => pm.expect(json.status).to.eql(400));",
              "pm.test('Error response has message', () => pm.expect(json).to.have.property('message'));",
              "pm.test('Error response has timestamp', () => pm.expect(json).to.have.property('timestamp'));",
              "pm.test('Response time under 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create todo - missing body (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/todos",
        "body": { "mode": "raw", "raw": "" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Message mentions malformed JSON', () => pm.expect(pm.response.json().message).to.include('Malformed'));"
            ]
          }
        }
      ]
    },
