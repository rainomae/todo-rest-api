    {
      "name": "PUT update todo - happy path",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/todos/{{todoId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Buy groceries and coffee\", \"description\": \"Updated list\", \"completed\": true}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Title is updated', () => pm.expect(json.title).to.eql('Buy groceries and coffee'));",
              "pm.test('Completed is true', () => pm.expect(json.completed).to.be.true);",
              "pm.test('updatedAt exists', () => pm.expect(json).to.have.property('updatedAt'));",
              "pm.test('Response time under 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ]
    },
