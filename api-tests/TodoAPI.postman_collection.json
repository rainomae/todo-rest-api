    {
      "name": "GET todo by id - happy path",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/todos/{{todoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('ID matches', () => pm.expect(String(json.id)).to.eql(pm.environment.get('todoId')));",
              "pm.test('Has title', () => pm.expect(json).to.have.property('title'));",
              "pm.test('Has completed field', () => pm.expect(json).to.have.property('completed'));",
              "pm.test('Response time under 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ]
    },
