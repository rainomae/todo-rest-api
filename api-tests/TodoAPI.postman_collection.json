            ]
          }
        }
      ]
    },
    {
      "name": "GET all todos - list has one item",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/todos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
